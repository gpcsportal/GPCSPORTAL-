APP_NAME="GPCS Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
# Railway MySQL mapping in the APP service Variables tab:
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_DATABASE=${{MySQL.MYSQLDATABASE}}
# DB_USERNAME=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# If the database service is renamed, replace "MySQL" above with its Railway service name.
# config/database.php also falls back to MYSQLHOST/MYSQLPORT/MYSQLDATABASE/MYSQLUSER/MYSQLPASSWORD.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gpcs_portal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

PAPER_MAX_MB=100
NOTES_MAX_MB=200
GALLERY_MAX_MB=20

ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=
ILOVEPDF_COMPRESSION_LEVEL=recommended

MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_URL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Admin session / bootstrap.
ADMIN_IDLE_MINUTES=30
# AdminSeeder reads these only from environment/config. Set a strong temporary password before seeding.
ADMIN_IDENTIFIER=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required PHP extensions are declared in composer.json so the builder can provision them.

# Set this as a Railway service variable so PHP CLI / artisan serve reads the project upload limits.
PHPRC=/app/php.ini
